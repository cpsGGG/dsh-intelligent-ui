{
  "name": "dsh-intelligent-ui",
  "version": "0.6.1",
  "private": true,
  "license": "MIT",
  "author": "cpsGGG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpsGGG/dsh-intelligent-ui.git"
  },
  "homepage": "https://github.com/cpsGGG/dsh-intelligent-ui#readme",
  "bugs": {
    "url": "https://github.com/cpsGGG/dsh-intelligent-ui/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "intelligent-ui", "generative-ui", "visualization", "charts", "diagrams"],
  "type": "module",
  "description": "DSH Intelligent UI：在原生回答中自动呈现图表、真实图片和可操作的组件。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build-plugin.mjs",
    "check": "npm run build && npm test",
    "demo": "node scripts/build-demo.mjs && node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "katex": "0.16.22",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "elkjs": "0.11.0",
    "html-to-image": "1.11.13"
  }
}
